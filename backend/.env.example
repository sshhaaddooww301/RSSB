# =============================================================
# DATABASE — Supabase / PostgreSQL (RECOMMENDED — FREE CLOUD DB)
# =============================================================
# Paste your Supabase "URI" connection string here.
# Find it at: Supabase Dashboard → Settings → Database → Connection string (URI tab)
# It looks like: postgresql://postgres:<your-password>@db.<project-ref>.supabase.co:5432/postgres
#
# Leave empty if you want to use the local Excel file instead.
DATABASE_URL=

# =============================================================
# Microsoft Graph API (Leave blank if using Supabase above)
# =============================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
EXCEL_FILE_ID=
EXCEL_DRIVE_ID=
SHAREPOINT_SITE_ID=

# =============================================================
# Application Settings
# =============================================================
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
APP_ENV=development
APP_PORT=8008
CORS_ORIGINS=http://localhost:3000

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
